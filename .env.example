APP_ENV=production
COOKIE_SECURE=false

POSTGRES_DB=sourceink
POSTGRES_USER=sourceink
POSTGRES_PASSWORD=change-this-development-password

# Required by the development Compose stack. Use a unique local password.
DEV_ADMIN_EMAIL=admin@sourceink.local
DEV_ADMIN_USERNAME=sourceink-admin
DEV_ADMIN_PASSWORD=adminadmin

# A regular account for testing the user-facing dashboard and GitHub linking.
DEV_USER_EMAIL=user@sourceink.local
DEV_USER_USERNAME=sourceink-user
DEV_USER_PASSWORD=adminadmin

GITHUB_PUBLISHER_APP_SLUG=your-github-app-slug
GITHUB_PUBLISHER_CLIENT_ID=your-github-app-client-id
GITHUB_PUBLISHER_CLIENT_SECRET=your-github-app-client-secret
# Used when running the Go server directly. Compose mounts this same file as a secret.
GITHUB_PUBLISHER_PRIVATE_KEY_PATH=.secrets/sourceink-publisher.pem
GITHUB_API_BASE_URL=https://api.github.com

# Configure the GitHub App Setup URL as:
# http://localhost:3000/api/github/setup
